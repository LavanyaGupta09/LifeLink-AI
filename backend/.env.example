# LifeLink AI Backend — Environment Configuration
# Copy to .env and fill in your actual values

# ============================================
# APP SETTINGS
# ============================================
APP_ENV=development
APP_NAME=LifeLink AI
APP_VERSION=1.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Set this to False to actually hit the real APIs instead of mocking!
USE_MOCK_APIS=False

# ============================================
# DATABASE & REDIS
# ============================================
DATABASE_URL=sqlite+aiosqlite:///./lifelink.db
REDIS_URL=redis://localhost:6379/0

# ============================================
# SECURITY & AUTH
# ============================================
SECRET_KEY=lifelink-ai-super-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY=your-32-byte-aes-encryption-key-here

# ============================================
# AI & MACHINE LEARNING
# ============================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=

# ============================================
# SMS & VERIFICATION (TWILIO)
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# ============================================
# NOTIFICATIONS (FIREBASE & RESEND)
# ============================================
FCM_SERVER_KEY=
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
RESEND_API_KEY=

# ============================================
# MAPS & ROUTING
# ============================================
MAPBOX_ACCESS_TOKEN=
OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_ROUTING_BASE_URL=http://router.project-osrm.org

# ============================================
# SUPABASE (STORAGE / DB)
# ============================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# WEBRTC (JITSI / STUN)
# ============================================
STUN_SERVER_1=stun:stun.l.google.com:19302
JITSI_DOMAIN=meet.jit.si
